<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title — АС Аптека</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="border-bottom app-header">
    <nav class="navbar navbar-expand-lg navbar-dark container">
        @Html.ActionLink("АС Аптека", "Index", "Home", null, new { @class = "navbar-brand fw-semibold" })
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">@Html.ActionLink("Главная", "Index", "Home", null, new { @class = "nav-link" })</li>
                <li class="nav-item">@Html.ActionLink("Препараты", "Index", "Medicines", null, new { @class = "nav-link" })</li>
                <li class="nav-item">@Html.ActionLink("Категории", "Index", "Categories", null, new { @class = "nav-link" })</li>
                <li class="nav-item">@Html.ActionLink("Поставщики", "Index", "Suppliers", null, new { @class = "nav-link" })</li>
                <li class="nav-item">@Html.ActionLink("Поступления", "Index", "Supplies", null, new { @class = "nav-link" })</li>
                <li class="nav-item">@Html.ActionLink("Продажи", "Index", "Sales", null, new { @class = "nav-link" })</li>
            </ul>
        </div>
    </nav>
</header>
<main class="container py-4">
    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success js-flash">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger js-flash">@error</div>
    }
    @RenderBody()
</main>
<footer class="border-top py-3 mt-auto">
    <div class="container text-muted small">Курсовая работа — АС «Аптека» (MVC)</div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@RenderSection("Scripts", required: false)
</body>
</html>
