@model IEnumerable<Sale>
@{
    ViewBag.Title = "Продажи";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Продажи</h1>
    @Html.ActionLink("Оформить продажу", "Create", null, null, new { @class = "btn btn-pharmacy" })
</div>

<div class="table-responsive card card-stat">
    <table class="table align-middle mb-0" id="dataTable">
        <thead>
        <tr>
            <th>№</th>
            <th>Дата</th>
            <th>Состав</th>
            <th>Сумма</th>
            <th class="text-end">Действия</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var sale in Model)
        {
            <tr>
                <td>@sale.Id</td>
                <td>@sale.SaleDate.ToString("dd.MM.yyyy")</td>
                <td>
                    <ul class="mb-0 ps-3">
                        @foreach (var item in sale.Items)
                        {
                            <li>@item.Medicine?.Name × @item.Quantity (@item.UnitPrice.ToString("N2") ₽)</li>
                        }
                    </ul>
                </td>
                <td>@sale.TotalAmount.ToString("N2") ₽</td>
                <td class="text-end">
                    @Html.ActionLink("Подробнее", "Details", new { id = sale.Id }, new { @class = "btn btn-sm btn-outline-secondary" })
                    @using (Html.BeginForm("Delete", "Sales", new { id = sale.Id }, FormMethod.Post, true, new { @class = "d-inline js-confirm-delete", data_confirm = "Удалить продажу и вернуть товар на склад?" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
