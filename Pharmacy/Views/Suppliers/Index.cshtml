@model IEnumerable<Supplier>
@{
    ViewBag.Title = "Поставщики";
    var search = ViewBag.Search as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Поставщики</h1>
    @Html.ActionLink("Создать", "Create", null, null, new { @class = "btn btn-pharmacy" })
</div>

@using (Html.BeginForm("Index", "Suppliers", FormMethod.Get, new { @class = "row g-2 mb-3" }))
{
    <div class="col-md-6">
        @Html.TextBox("search", search, new { @class = "form-control", placeholder = "Поиск по названию, телефону, адресу" })
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-secondary" type="submit">Найти</button>
        @Html.ActionLink("Сброс", "Index", null, null, new { @class = "btn btn-link" })
    </div>
}

<div class="table-responsive card card-stat">
    <table class="table align-middle mb-0" id="dataTable">
        <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.Name)</th>
            <th>@Html.DisplayNameFor(m => m.Phone)</th>
            <th>@Html.DisplayNameFor(m => m.Address)</th>
            <th class="text-end">Действия</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(_ => item.Name)</td>
                <td>@Html.DisplayFor(_ => item.Phone)</td>
                <td>@Html.DisplayFor(_ => item.Address)</td>
                <td class="text-end">
                    @Html.ActionLink("Изменить", "Edit", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-primary" })
                    @using (Html.BeginForm("Delete", "Suppliers", new { id = item.Id }, FormMethod.Post, true, new { @class = "d-inline js-confirm-delete", data_confirm = "Удалить поставщика?" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
